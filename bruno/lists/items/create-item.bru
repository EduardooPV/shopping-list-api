meta {
  name: Create Item
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/lists/{{listId}}/items
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Arroz",
    "quantity": 2,
    "amount": 10,
    "status": "pending"
  }
}

script:post-response {
  if (res.status === 201 && res.body.id) {
    bru.setVar("itemId", res.body.id);
  }
}
