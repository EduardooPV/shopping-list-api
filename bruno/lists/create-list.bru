meta {
  name: Create List
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/lists
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Mercado semana"
  }
}

script:post-response {
  if (res.status === 201 && res.body.id) {
    bru.setVar("listId", res.body.id);
  }
}
